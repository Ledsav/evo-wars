{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup: check Node version",
      "type": "shell",
      "command": "node -e \"const [a,b]=process.versions.node.split('.').map(Number);const ok=a>22?true:a===22?b>=12:a===20?b>=19:false;if(!ok){console.error('Node '+process.versions.node+' is too old: Vite 7 needs 20.19+ or 22.12+.');process.exit(1)}console.log('Node '+process.versions.node+' OK')\"",
      "problemMatcher": []
    },
    {
      "label": "setup: install npm packages",
      "type": "shell",
      "command": "npm ci",
      "problemMatcher": []
    },
    {
      "label": "setup: lint and build",
      "detail": "Verifies the clone: eslint, then vite build into dist/",
      "dependsOrder": "sequence",
      "dependsOn": ["Lint", "Build"],
      "problemMatcher": []
    },
    {
      "label": "Setup (fresh clone)",
      "detail": "Checks Node, runs npm ci, lints and builds (the Python analysis/ venv is separate: Analysis: set up venv)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "setup: check Node version",
        "setup: install npm packages",
        "setup: lint and build"
      ],
      "problemMatcher": []
    },
    {
      "label": "Dev",
      "detail": "Vite dev server on http://localhost:5173/evo-wars/",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "analysis: create venv",
      "type": "shell",
      "options": {"cwd": "${workspaceFolder}/analysis"},
      "command": "python3 -m venv venv",
      "windows": {"command": "python -m venv venv"},
      "problemMatcher": []
    },
    {
      "label": "analysis: install requirements",
      "type": "shell",
      "options": {"cwd": "${workspaceFolder}/analysis"},
      "command": "venv/bin/python -m pip install -r requirements.txt",
      "windows": {"command": "venv\\Scripts\\python -m pip install -r requirements.txt"},
      "problemMatcher": []
    },
    {
      "label": "Analysis: set up venv",
      "detail": "Optional: analysis/venv with the Jupyter stack from analysis/requirements.txt",
      "dependsOrder": "sequence",
      "dependsOn": ["analysis: create venv", "analysis: install requirements"],
      "problemMatcher": []
    }
  ]
}
